# Postgres connection string (Supabase transaction pooler recommended for serverless hosts).
# See https://supabase.com/docs/guides/database/connecting-to-postgres for the exact format.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
AUTH_SECRET="replace-with-a-long-random-string"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Read-only RAG lookup against the Supabase GAT question bank.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
