# Postgres connection string (e.g. a Supabase project's pooler URL for serverless-friendly
# connection limits — see prisma/schema.prisma and src/lib/db.ts).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
AUTH_SECRET="replace-with-a-long-random-string"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Read-only RAG lookup against the Supabase GAT question bank.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
